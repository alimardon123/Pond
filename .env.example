# Pond — environment variables for S3/R2 storage.
#
# Copy this file to `.env` and fill in your own credentials:
#   cp .env.example .env
#   # edit .env with your favorite editor
#   set -a; source .env; set +a  # load into shell
#
# NEVER commit .env to git. It is in .gitignore (verify with `git check-ignore .env`).
#
# ──────────────────────────────────────────────────────────────────────────
# CLOUDFLARE R2 (S3-compatible)
# ──────────────────────────────────────────────────────────────────────────
# Where to get these values:
#   https://developers.cloudflare.com/r2/api/s3/api/
#   - account_id:    Cloudflare dashboard → R2 → Overview (right sidebar)
#   - access_key:    R2 dashboard → Manage R2 API Tokens → Create API Token
#                    (select "Object Read & Write" permission)
#   - secret_key:    shown ONCE when you create the token — save it immediately
#   - bucket:        the bucket name you created in R2
#
# R2 connection details
R2_ACCOUNT_ID="your-account-id"
R2_BUCKET="your-bucket-name"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_REGION="auto"

# R2 API Token (for Cloudflare's native API — NOT needed for S3-compatible access)
# R2_API_TOKEN="cfat_..."

# S3-compatible credentials (used by Pond's Rust S3 backend AND boto3)
# These are the Access Key ID + Secret Access Key from the R2 API Token you created.
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_DEFAULT_REGION="auto"

# Convenience: full Pond S3 URL for use with the `pond` CLI
# Usage:  pond --root "$POND_S3_URL" write users --json '[{"id":1}]' -m init
POND_S3_URL="s3://your-bucket/pond?region=auto&endpoint=https://your-account-id.r2.cloudflarestorage.com"

# ──────────────────────────────────────────────────────────────────────────
# AWS S3 (alternative)
# ──────────────────────────────────────────────────────────────────────────
# Use standard AWS endpoint + your IAM credentials:
#   AWS_ACCESS_KEY_ID="AKIA..."
#   AWS_SECRET_ACCESS_KEY="..."
#   AWS_DEFAULT_REGION="us-east-1"
#   POND_S3_URL="s3://your-bucket/prod?region=us-east-1"

# ──────────────────────────────────────────────────────────────────────────
# MINIO / LOCALSTACK / OTHER S3-COMPATIBLE
# ──────────────────────────────────────────────────────────────────────────
#   AWS_ACCESS_KEY_ID="minioadmin"
#   AWS_SECRET_ACCESS_KEY="minioadmin"
#   AWS_DEFAULT_REGION="us-east-1"
#   POND_S3_URL="s3://my-bucket/pond?region=us-east-1&endpoint=http://localhost:9000"
