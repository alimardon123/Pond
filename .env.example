# Pond — environment variables for S3/R2 benchmarks and demos.
#
# Copy this file to `.env` and fill in your own credentials:
#   cp .env.example .env
#   # edit .env with your favorite editor
#   set -a; source .env; set +a  # load into shell
#
# Then run any R2 script:
#   python scripts/benchmark_r2_quick.py
#
# NEVER commit .env to git. It is in .gitignore (verify if not).
#
# Where to get these values:
#   Cloudflare R2:  https://developers.cloudflare.com/r2/api/s3/api/
#       endpoint:    https://<account-id>.r2.cloudflarestorage.com
#       access_key:  created in R2 dashboard → Manage R2 API Tokens
#       secret_key:  shown once when you create the token
#       bucket:      the bucket name you created in R2
#
#   AWS S3:          use the standard AWS endpoint + your IAM credentials
#       endpoint:    https://s3.<region>.amazonaws.com
#       access_key:  your IAM user's access key ID
#       secret_key:  your IAM user's secret access key
#       bucket:      your S3 bucket name
#
#   MinIO / LocalStack / etc.:  use their endpoint + credentials.

R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY="your-access-key-id"
R2_SECRET_KEY="your-secret-access-key"
R2_BUCKET="your-bucket-name"
# Optional: key prefix for the benchmark data (defaults to a timestamp)
# R2_PREFIX="bench-$(date +%s)"
